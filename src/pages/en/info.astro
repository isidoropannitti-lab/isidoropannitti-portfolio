---
import SectionsLayout from "../../layouts/SectionsLayout.astro";
import { readFile } from "node:fs/promises";

const DEFAULT_BIO =
	"Architect working across residential interior and exhibition design.\nDevelops private residential interiors in direct collaboration with clients, from concept to completion.\nInvolved in cultural and museum projects, including art exhibition production and coordination with contractors and institutions.";

let bioText = DEFAULT_BIO;

const archiveItems = [
	{ place: "Milan", year: "2026", type: "museum installation", href: "/en/projects/26-2" },
	{ place: "Rome", year: "2025", type: "private residence", href: "/en/projects/25-6" },
	{ place: "Milan", year: "2025", type: "museum installation", href: "/en/projects/25-4" },
	{ place: "Milan", year: "2025", type: "private residence", href: "/en/projects/25-2" },
	{ place: "Maddaloni", year: "2025", type: "public pavilion", href: "/en/projects/25-1" },
	{ place: "Milan", year: "2023", type: "exhibition installation", href: "/en/projects/23-4" },
];

try {
	const fileText = await readFile(new URL("../../../public/content/info-bio-en.txt", import.meta.url), "utf-8");
	const clean = fileText.trim();
	if (clean) bioText = clean;
} catch {
	try {
		const fallbackText = await readFile(new URL("../../../public/content/info-bio.txt", import.meta.url), "utf-8");
		const fallbackClean = fallbackText.trim();
		if (fallbackClean) bioText = fallbackClean;
	} catch {
		// Use default text if files are missing.
	}
}
---

<SectionsLayout title="info | isidoro pannitti architetto" section="info" lang="en">
	<section class="info-content" aria-label="Bio and work list">
		<p class="bio">{bioText}</p>
		<div class="archive-block" data-info-archive>
			<button
				class="archive-toggle"
				type="button"
				aria-expanded="false"
				aria-controls="archive-list-en"
				data-info-archive-toggle
			>
				work list
			</button>
			<ul class="archive-list" id="archive-list-en" data-info-archive-list>
				{archiveItems.map((item) => <li><a href={item.href}>{item.place}, {item.year}, {item.type}</a></li>)}
			</ul>
		</div>
	</section>
</SectionsLayout>

<style>
	.info-content {
		max-width: 44rem;
	}

	.bio {
		margin: 0;
		white-space: pre-line;
	}

	.archive-block {
		margin-top: var(--space-32);
		opacity: 0;
		transform: translateY(var(--space-8));
		transition: opacity 900ms cubic-bezier(0.22, 1, 0.36, 1),
			transform 900ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.archive-block.is-visible {
		opacity: 1;
		transform: translateY(0);
	}

	.archive-toggle {
		--press-scale: 1;
		--archive-x: 0px;
		--archive-y: 0px;
		--archive-scale-x: 1;
		--archive-scale-y: 1;
		padding: 0;
		border: 0;
		background: transparent;
		color: rgba(0, 0, 0, 0.22);
		font: inherit;
		font-weight: 300;
		cursor: pointer;
		transform: translate3d(var(--archive-x), var(--archive-y), 0)
			scale(
				calc(var(--press-scale) * var(--archive-scale-x)),
				calc(var(--press-scale) * var(--archive-scale-y))
			);
		transform-origin: left center;
		transition: color 260ms ease, transform 680ms cubic-bezier(0.16, 1, 0.26, 1);
		-webkit-tap-highlight-color: transparent;
	}

	.archive-toggle:hover,
	.archive-toggle:focus-visible {
		color: rgba(0, 0, 0, 0.42);
	}

	.archive-toggle:active {
		--press-scale: 0.975;
		transition-duration: 120ms;
	}

	.archive-list {
		display: grid;
		gap: var(--space-8);
		max-height: 0;
		margin: 0;
		padding: 0;
		list-style: none;
		overflow: hidden;
		opacity: 0;
		transform: translateY(calc(var(--space-8) * -1));
		transition: max-height 640ms cubic-bezier(0.22, 1, 0.36, 1),
			margin-top 640ms cubic-bezier(0.22, 1, 0.36, 1),
			opacity 360ms ease,
			transform 520ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.archive-list a {
		display: inline-block;
		color: rgba(0, 0, 0, 0.22);
		text-decoration: none;
		transform-origin: left center;
		transition: color 220ms ease, transform 180ms cubic-bezier(0.2, 1, 0.34, 1);
	}

	.archive-list a:hover,
	.archive-list a:focus-visible {
		color: rgba(0, 0, 0, 0.34);
	}

	.archive-list a:active {
		transform: scale(0.992);
		transition-duration: 120ms;
	}

	.archive-block.is-open .archive-list {
		max-height: 18rem;
		margin-top: var(--space-16);
		opacity: 1;
		transform: translateY(0);
	}
</style>

<script>
	const archive = document.querySelector("[data-info-archive]");
	const archiveToggle = document.querySelector("[data-info-archive-toggle]");

	if (archive instanceof HTMLElement && archiveToggle instanceof HTMLButtonElement) {
		window.setTimeout(() => {
			archive.classList.add("is-visible");
		}, 2600);

		archiveToggle.addEventListener("click", () => {
			const isOpen = archive.classList.toggle("is-open");
			archiveToggle.setAttribute("aria-expanded", String(isOpen));
		});

		if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
			const supportsFinePointer = window.matchMedia("(pointer: fine)").matches;
			const radius = supportsFinePointer ? 136 : 96;
			const maxShift = supportsFinePointer ? 7 : 11;
			let frame = 0;
			let activePointerId = null;

			const resetArchiveMagnet = () => {
				archiveToggle.style.setProperty("--archive-x", "0px");
				archiveToggle.style.setProperty("--archive-y", "0px");
				archiveToggle.style.setProperty("--archive-scale-x", "1");
				archiveToggle.style.setProperty("--archive-scale-y", "1");
			};

			const pullArchiveToggle = (clientX, clientY) => {
				const rect = archiveToggle.getBoundingClientRect();
				const centerX = rect.left + rect.width / 2;
				const centerY = rect.top + rect.height / 2;
				const deltaX = clientX - centerX;
				const deltaY = clientY - centerY;
				const distance = Math.hypot(deltaX, deltaY);

				if (distance > radius) {
					resetArchiveMagnet();
					return;
				}

				const pull = Math.pow(1 - distance / radius, 1.28);
				const angle = Math.atan2(deltaY, deltaX);
				const axisX = Math.abs(Math.cos(angle));
				const axisY = Math.abs(Math.sin(angle));
				const shiftX = Math.cos(angle) * maxShift * pull;
				const shiftY = Math.sin(angle) * maxShift * pull;
				const stretch = 1 + pull * (supportsFinePointer ? 0.14 : 0.32);
				const squeeze = 1 - pull * (supportsFinePointer ? 0.055 : 0.16);

				archiveToggle.style.setProperty("--archive-x", `${shiftX.toFixed(2)}px`);
				archiveToggle.style.setProperty("--archive-y", `${shiftY.toFixed(2)}px`);
				archiveToggle.style.setProperty(
					"--archive-scale-x",
					(1 + (stretch - 1) * axisX - (1 - squeeze) * axisY).toFixed(3)
				);
				archiveToggle.style.setProperty(
					"--archive-scale-y",
					(1 + (stretch - 1) * axisY - (1 - squeeze) * axisX).toFixed(3)
				);
			};

			if (supportsFinePointer) {
				window.addEventListener(
					"pointermove",
					(event) => {
						if (frame) return;
						frame = window.requestAnimationFrame(() => {
							frame = 0;
							pullArchiveToggle(event.clientX, event.clientY);
						});
					},
					{ passive: true }
				);
			} else {
				archiveToggle.addEventListener("pointerdown", (event) => {
					activePointerId = event.pointerId;
					archiveToggle.setPointerCapture?.(event.pointerId);
					pullArchiveToggle(event.clientX, event.clientY);
				});

				archiveToggle.addEventListener("pointermove", (event) => {
					if (event.pointerId !== activePointerId) return;
					pullArchiveToggle(event.clientX, event.clientY);
				});

				const releaseArchiveToggle = () => {
					activePointerId = null;
					resetArchiveMagnet();
				};

				archiveToggle.addEventListener("pointerup", releaseArchiveToggle);
				archiveToggle.addEventListener("pointercancel", releaseArchiveToggle);
			}

			window.addEventListener("blur", resetArchiveMagnet);
		}
	}
</script>
