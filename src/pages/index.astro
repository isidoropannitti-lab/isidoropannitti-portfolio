---
import SectionsLayout from "../layouts/SectionsLayout.astro";

const ARCHITECTURE_IMAGES = [
	{ src: "/images/architecture/23.4-cover.webp", label: "23.4", slug: "23-4", variant: "is-base" },
	{ src: "/images/architecture/25-1-cover.webp", label: "25.1", slug: "25-1", variant: "is-base" },
	{ src: "/images/architecture/25-2-cover.webp", label: "25.2", slug: "25-2", variant: "is-base" },
	{ src: "/images/architecture/25-3-cover.webp", label: "25.3", onGoing: true, variant: "is-wide" },
	{ src: "/images/architecture/25-4-cover.webp", label: "25.4", slug: "25-4", variant: "is-compact" },
	{ src: "/images/architecture/25-6-cover.webp", label: "25.6", slug: "25-6", variant: "is-base" },
	{ src: "/images/architecture/25-8-cover.webp", label: "25.8", onGoing: true, variant: "is-base" },
	{ src: "/images/architecture/26-2-cover.jpeg", label: "26.2", slug: "26-2", variant: "is-wide" },
];

const LOOPED_ARCHITECTURE_IMAGES = [0, 1, 2].flatMap((setIndex) =>
	ARCHITECTURE_IMAGES.map((image, imageIndex) => ({ ...image, setIndex, imageIndex }))
);
---

<SectionsLayout title="isidoro pannitti architetto" section="architecture" lang="it" lockMobileScrollY>
	<div
		class="gallery-stage"
		data-home-gallery-stage
		data-loop-gallery
		data-reset-gallery
		aria-label="Architecture sequence"
	>
		<div class="gallery" data-home-gallery aria-label="Architecture sequence">
			{
				LOOPED_ARCHITECTURE_IMAGES.map((image) => (
					<figure
						class:list={["preview", image.variant]}
						data-loop-item
						data-loop-set={image.setIndex}
						data-loop-index={image.imageIndex}
						aria-hidden={image.setIndex !== 1 ? "true" : undefined}
					>
						{
							image.onGoing ? (
								<>
									<input
										class="ongoing-toggle"
										type="checkbox"
										id={`ongoing-${image.setIndex}-${image.label.replace(".", "-")}`}
									/>
									<label
										class="project-link ongoing-trigger magnetic-target pressable"
										for={`ongoing-${image.setIndex}-${image.label.replace(".", "-")}`}
										data-magnetic
									>
										<img src={image.src} alt={image.label} loading="eager" />
									</label>
								</>
							) : image.slug ? (
								<a href={`/projects/${image.slug}`} class="project-link magnetic-target pressable" data-magnetic>
									<img src={image.src} alt={image.label} loading="eager" />
								</a>
							) : (
								<img class="magnetic-target pressable" src={image.src} alt={image.label} loading="eager" data-magnetic />
							)
						}
						<figcaption>
							<span>{image.label}</span>
							{
								image.onGoing && (
									<span class="ongoing-label" aria-live="polite">in corso</span>
								)
							}
						</figcaption>
					</figure>
				))
			}
		</div>
	</div>
</SectionsLayout>

<style>
	.gallery-stage {
		box-sizing: border-box;
		width: calc(100% + (var(--edge) * 2));
		margin-top: calc(var(--space-8) * -1);
		margin-inline: calc(var(--edge) * -1);
		overflow-x: auto;
		overflow-y: hidden;
		overscroll-behavior-x: contain;
		padding-top: var(--space-8);
		padding-left: var(--edge);
		padding-right: var(--edge);
		padding-bottom: var(--space-8);
		scroll-padding-left: var(--edge);
		scroll-snap-type: x proximity;
		touch-action: pan-x;
		-webkit-overflow-scrolling: touch;
		scrollbar-width: none;
		-ms-overflow-style: none;
	}

	.gallery-stage::-webkit-scrollbar {
		width: 0;
		height: 0;
		display: none;
	}

	.gallery {
		display: flex;
		align-items: flex-start;
		flex-wrap: nowrap;
		box-sizing: border-box;
		width: max-content;
		min-width: max-content;
		gap: var(--space-16);
		overflow: visible;
	}

	.preview {
		flex: 0 0 auto;
		margin: 0;
		display: grid;
		gap: var(--space-16);
		scroll-snap-align: start;
	}

	.preview img {
		display: block;
		width: auto;
		height: clamp(23rem, 38vw, 28rem);
		object-fit: cover;
		object-position: center;
	}

	.project-link {
		display: block;
	}

	.ongoing-toggle {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}

	.ongoing-trigger {
		cursor: pointer;
	}

	.preview figcaption {
		display: flex;
		align-items: baseline;
		gap: var(--space-8);
	}

	.ongoing-label {
		opacity: 0;
		transform: translateY(var(--space-4));
		transition: opacity 320ms ease, transform 360ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.ongoing-toggle:checked ~ figcaption .ongoing-label {
		opacity: 1;
		transform: translateY(0);
	}

	.ongoing-trigger img {
		pointer-events: none;
	}

	@media (max-width: 760px) {
		.gallery-stage {
			--mobile-card-width: clamp(16rem, 72vw, 20rem);
			--mobile-caption-space: var(--space-64);
			--mobile-card-height: min(
				clamp(24rem, 58svh, 30rem),
				calc(
					100svh - var(--mobile-main-top) - var(--mobile-main-bottom) -
						var(--mobile-caption-space) - var(--space-16) - env(safe-area-inset-bottom, 0px)
				)
			);
			flex: 1 1 auto;
			height: auto;
			min-height: 0;
			display: flex;
			align-items: flex-start;
			width: 100%;
			margin-inline: 0;
			overflow-x: auto;
			overflow-y: hidden;
			overscroll-behavior-x: contain;
			overscroll-behavior-y: none;
			scroll-snap-type: x mandatory;
			scroll-padding-left: 0;
			touch-action: pan-x;
			-webkit-overflow-scrolling: touch;
			box-sizing: border-box;
			margin-top: calc(var(--space-8) * -1);
			padding: var(--space-8) calc((100% - var(--mobile-card-width)) / 2)
				max(var(--space-32), calc(env(safe-area-inset-bottom, 0px) + var(--space-24))) 0;
			scrollbar-width: none;
			-ms-overflow-style: none;
		}

		.gallery-stage::-webkit-scrollbar {
			width: 0;
			height: 0;
			display: none;
		}

		.gallery {
			width: max-content;
			min-width: max-content;
			align-self: flex-start;
			overflow: visible;
			margin-inline: 0;
			padding: 0 var(--edge) 0 0;
		}

		.preview {
			width: var(--mobile-card-width);
			scroll-snap-align: center;
		}

		.preview:first-child {
			scroll-snap-align: start;
		}

		.preview.is-compact {
			width: var(--mobile-card-width);
		}

		.preview.is-wide {
			width: var(--mobile-card-width);
		}

		.preview img {
			width: 100%;
			height: var(--mobile-card-height);
			aspect-ratio: auto;
			object-fit: cover;
		}

		.preview figcaption {
			min-height: var(--mobile-caption-space);
			padding-bottom: var(--space-8);
		}
	}
</style>

<script>
	const stage = document.querySelector("[data-home-gallery-stage]");
	const gallery = document.querySelector("[data-home-gallery]");

	if (stage instanceof HTMLElement && gallery instanceof HTMLElement) {
		const mobileQuery = window.matchMedia("(max-width: 760px)");
		let segmentWidth = 0;
		let middleStart = 0;
		let normalizeTimer: number | undefined;
		let initialized = false;

		const getItemPosition = (scroller: HTMLElement, item: HTMLElement) =>
			item.getBoundingClientRect().left - scroller.getBoundingClientRect().left + scroller.scrollLeft;

		const measure = () => {
			const firstMiddle = gallery.querySelector('[data-loop-set="1"][data-loop-index="0"]');
			const firstNext = gallery.querySelector('[data-loop-set="2"][data-loop-index="0"]');
			if (!(firstMiddle instanceof HTMLElement) || !(firstNext instanceof HTMLElement)) return false;

			middleStart = getItemPosition(stage, firstMiddle);
			segmentWidth = getItemPosition(stage, firstNext) - middleStart;
			return segmentWidth > 0;
		};

		const moveToMiddle = () => {
			if (!measure()) return;
			stage.scrollLeft = middleStart;
			initialized = true;
		};

		const normalizeLoop = () => {
			if (!initialized && !measure()) return;
			if (!segmentWidth) return;

			const relative = stage.scrollLeft - middleStart;
			if (relative < segmentWidth * -0.5) {
				stage.scrollLeft += segmentWidth;
			} else if (relative > segmentWidth * 0.5) {
				stage.scrollLeft -= segmentWidth;
			}
		};

		const scheduleNormalize = () => {
			window.clearTimeout(normalizeTimer);
			normalizeTimer = window.setTimeout(normalizeLoop, 120);
		};

		const onWheel = (event: WheelEvent) => {
			if (mobileQuery.matches) return;
			const horizontalIntent = Math.abs(event.deltaX) > Math.abs(event.deltaY);
			const delta = horizontalIntent ? event.deltaX : event.deltaY;
			if (!delta) return;

			event.preventDefault();
			stage.scrollLeft += delta;
			scheduleNormalize();
		};

		const resetLoop = () => {
			window.requestAnimationFrame(() => {
				window.requestAnimationFrame(moveToMiddle);
			});
		};

		stage.addEventListener("wheel", onWheel, { passive: false });
		stage.addEventListener("scroll", scheduleNormalize, { passive: true });
		mobileQuery.addEventListener("change", resetLoop);
		window.addEventListener("resize", resetLoop, { passive: true });
		window.addEventListener("load", resetLoop, { once: true });
		window.addEventListener("pageshow", resetLoop);
		resetLoop();
	}
</script>
