---
import SectionsLayout from "../layouts/SectionsLayout.astro";
import { readFile } from "node:fs/promises";

const DEFAULT_BIO =
	"Architect working across residential interior and exhibition design.\nDevelops private residential interiors in direct collaboration with clients, from concept to completion.\nInvolved in cultural and museum projects, including art exhibition production and coordination with contractors and institutions.";

let bioText = DEFAULT_BIO;

try {
	const fileText = await readFile(new URL("../../public/content/info-bio-it.txt", import.meta.url), "utf-8");
	const clean = fileText.trim();
	if (clean) bioText = clean;
} catch {
	try {
		const fallbackText = await readFile(new URL("../../public/content/info-bio.txt", import.meta.url), "utf-8");
		const fallbackClean = fallbackText.trim();
		if (fallbackClean) bioText = fallbackClean;
	} catch {
		// Use default text if files are missing.
	}
}
---

<SectionsLayout title="info | isidoro pannitti architetto" section="info" lang="it" lockMobileScrollY>
	<section class="info-content" aria-label="Bio">
		<p class="bio">{bioText}</p>
	</section>
	<a class="bio-lang-switch pressable pressable-control" href="/en/info" aria-label="Mostra bio in inglese">
		<span class="active">it</span>/<span>en</span>
	</a>
</SectionsLayout>

<style>
	.info-content {
		max-width: 44rem;
	}

	.bio {
		margin: 0;
		white-space: pre-line;
	}

	.bio-lang-switch {
		position: fixed;
		left: var(--edge);
		bottom: var(--edge-y);
		z-index: 20;
		color: rgba(0, 0, 0, 0.16);
		text-decoration: none;
		text-transform: lowercase;
		transition: color 220ms ease, opacity 220ms ease, transform 170ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.bio-lang-switch:hover,
	.bio-lang-switch:focus-visible {
		color: rgba(0, 0, 0, 0.32);
	}

	.bio-lang-switch .active {
		color: rgba(0, 0, 0, 0.26);
	}

	@media (max-width: 720px) {
		.bio-lang-switch {
			bottom: var(--space-32);
		}
	}
</style>
