---
import SectionsLayout from "../layouts/SectionsLayout.astro";

const ARCHITECTURE_IMAGES = [
	{ src: "/images/architecture/23.4-cover.webp", label: "23.4", slug: "23-4", variant: "is-base" },
	{ src: "/images/architecture/25-1-cover.webp", label: "25.1", slug: "25-1", variant: "is-base" },
	{ src: "/images/architecture/25-2-cover.webp", label: "25.2", slug: "25-2", variant: "is-base" },
	{ src: "/images/architecture/25-3-cover.webp", label: "25.3", onGoing: true, variant: "is-wide" },
	{ src: "/images/architecture/25-4-cover.webp", label: "25.4", slug: "25-4", variant: "is-compact" },
	{ src: "/images/architecture/25-6-cover.webp", label: "25.6", slug: "25-6", variant: "is-base" },
	{ src: "/images/architecture/25-8-cover.webp", label: "25.8", onGoing: true, variant: "is-base" },
	{ src: "/images/architecture/26-2-cover.jpeg", label: "26.2", slug: "26-2", variant: "is-wide" },
];
---

<SectionsLayout title="isidoro pannitti architetto" section="architecture" lang="it" lockMobileScrollY>
	<div
		class="gallery-stage"
		data-home-gallery-stage
		data-reset-gallery
		aria-label="Architecture sequence"
	>
		<div class="gallery" data-home-gallery aria-label="Architecture sequence">
			{
				ARCHITECTURE_IMAGES.map((image) => (
					<figure class:list={["preview", image.variant]}>
						{
							image.onGoing ? (
								<>
									<input
										class="ongoing-toggle"
										type="checkbox"
										id={`ongoing-${image.label.replace(".", "-")}`}
									/>
									<label
										class="project-link ongoing-trigger magnetic-target pressable"
										for={`ongoing-${image.label.replace(".", "-")}`}
										style={`--cover-image: url("${image.src}")`}
										data-magnetic
										data-water-cover
									>
										<img src={image.src} alt={image.label} loading="eager" />
									</label>
								</>
							) : image.slug ? (
								<a
									href={`/projects/${image.slug}`}
									class="project-link magnetic-target pressable"
									style={`--cover-image: url("${image.src}")`}
									data-magnetic
									data-water-cover
								>
									<img src={image.src} alt={image.label} loading="eager" />
								</a>
							) : (
								<img class="magnetic-target pressable" src={image.src} alt={image.label} loading="eager" data-magnetic />
							)
						}
						<figcaption>
							<span>{image.label}</span>
							{
								image.onGoing && (
									<span class="ongoing-label" aria-live="polite">in corso</span>
								)
							}
						</figcaption>
					</figure>
				))
			}
		</div>
	</div>
</SectionsLayout>

<style>
	.gallery-stage {
		width: 100%;
	}

	.gallery {
		display: flex;
		align-items: flex-start;
		flex-wrap: nowrap;
		box-sizing: border-box;
		width: calc(100% + (var(--edge) * 2));
		gap: var(--space-16);
		margin-top: calc(var(--space-8) * -1);
		margin-inline: calc(var(--edge) * -1);
		overflow-x: auto;
		overscroll-behavior-x: contain;
		padding-top: var(--space-8);
		padding-left: var(--edge);
		padding-right: var(--edge);
		scroll-padding-left: var(--edge);
		scroll-snap-type: x proximity;
		touch-action: pan-x;
		-webkit-overflow-scrolling: touch;
		padding-bottom: var(--space-8);
		scrollbar-width: none;
		-ms-overflow-style: none;
	}

	.gallery::-webkit-scrollbar {
		width: 0;
		height: 0;
		display: none;
	}

	.preview {
		flex: 0 0 auto;
		margin: 0;
		display: grid;
		gap: var(--space-16);
		scroll-snap-align: start;
	}

	.preview img {
		display: block;
		width: auto;
		height: clamp(23rem, 38vw, 28rem);
		object-fit: cover;
		object-position: center;
	}

	.project-link {
		--water-x: 50%;
		--water-y: 50%;
		display: block;
		position: relative;
		overflow: hidden;
		isolation: isolate;
		line-height: 0;
	}

	.project-link::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: 1;
		pointer-events: none;
		opacity: 0;
		background-image: var(--cover-image);
		background-position: center;
		background-size: cover;
		background-repeat: no-repeat;
		clip-path: circle(0 at var(--water-x) var(--water-y));
		filter: saturate(1.04) contrast(1.025) brightness(1.012);
		transform: scale(1.055);
		transform-origin: var(--water-x) var(--water-y);
		transition:
			clip-path 640ms cubic-bezier(0.16, 1, 0.3, 1),
			opacity 420ms ease,
			transform 760ms cubic-bezier(0.16, 1, 0.3, 1);
		will-change: clip-path, transform, opacity;
	}

	.project-link::after {
		content: "";
		position: absolute;
		z-index: 2;
		left: var(--water-x);
		top: var(--water-y);
		width: clamp(4rem, 8vw, 6.5rem);
		aspect-ratio: 1;
		pointer-events: none;
		opacity: 0;
		border-radius: 999px;
		background:
			radial-gradient(circle at 34% 28%, rgba(255, 255, 255, 0.26), rgba(255, 255, 255, 0.06) 34%, rgba(255, 255, 255, 0) 68%),
			radial-gradient(circle at 68% 72%, rgba(0, 0, 0, 0.07), rgba(0, 0, 0, 0) 58%);
		mix-blend-mode: soft-light;
		transform: translate3d(-50%, -50%, 0) scale(0.72);
		transition:
			left 180ms linear,
			top 180ms linear,
			opacity 360ms ease,
			transform 640ms cubic-bezier(0.16, 1, 0.3, 1);
	}

	@media (hover: hover) and (pointer: fine) {
		.project-link:hover::before {
			opacity: 1;
			clip-path: circle(clamp(2.8rem, 5.2vw, 4.8rem) at var(--water-x) var(--water-y));
			transform: scale(1.075);
		}

		.project-link:hover::after {
			opacity: 1;
			transform: translate3d(-50%, -50%, 0) scale(1);
		}
	}

	.ongoing-toggle {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}

	.ongoing-trigger {
		cursor: pointer;
	}

	.preview figcaption {
		display: flex;
		align-items: baseline;
		gap: var(--space-8);
	}

	.ongoing-label {
		opacity: 0;
		transform: translateY(var(--space-4));
		transition: opacity 320ms ease, transform 360ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.ongoing-toggle:checked ~ figcaption .ongoing-label {
		opacity: 1;
		transform: translateY(0);
	}

	.ongoing-trigger img {
		pointer-events: none;
	}

	@media (prefers-reduced-motion: reduce) {
		.project-link::before,
		.project-link::after {
			display: none;
		}
	}

	@media (max-width: 760px) {
		.gallery-stage {
			--mobile-card-width: clamp(16rem, 72vw, 20rem);
			--mobile-caption-space: var(--space-64);
			--mobile-card-height: min(
				clamp(24rem, 58svh, 30rem),
				calc(
					100svh - var(--mobile-main-top) - var(--mobile-main-bottom) -
						var(--mobile-caption-space) - var(--space-16) - env(safe-area-inset-bottom, 0px)
				)
			);
			flex: 1 1 auto;
			height: auto;
			min-height: 0;
			display: flex;
			align-items: flex-start;
			overflow-x: auto;
			overflow-y: hidden;
			overscroll-behavior-x: contain;
			overscroll-behavior-y: none;
			scroll-snap-type: x mandatory;
			scroll-padding-left: 0;
			touch-action: pan-x;
			-webkit-overflow-scrolling: touch;
			box-sizing: border-box;
			margin-top: calc(var(--space-8) * -1);
			padding: var(--space-8) calc((100% - var(--mobile-card-width)) / 2)
				max(var(--space-32), calc(env(safe-area-inset-bottom, 0px) + var(--space-24))) 0;
			scrollbar-width: none;
			-ms-overflow-style: none;
		}

		.gallery-stage::-webkit-scrollbar {
			width: 0;
			height: 0;
			display: none;
		}

		.gallery {
			width: max-content;
			min-width: max-content;
			align-self: flex-start;
			overflow: visible;
			margin-inline: 0;
			padding: 0 var(--edge) 0 0;
		}

		.preview {
			width: var(--mobile-card-width);
			scroll-snap-align: center;
		}

		.preview:first-child {
			scroll-snap-align: start;
		}

		.preview.is-compact {
			width: var(--mobile-card-width);
		}

		.preview.is-wide {
			width: var(--mobile-card-width);
		}

		.preview img {
			width: 100%;
			height: var(--mobile-card-height);
			aspect-ratio: auto;
			object-fit: cover;
		}

		.preview figcaption {
			min-height: var(--mobile-caption-space);
			padding-bottom: var(--space-8);
		}
	}
</style>

<script>
	document.querySelectorAll<HTMLElement>("[data-water-cover]").forEach((cover) => {
		cover.addEventListener("pointermove", (event) => {
			if (!event.isPrimary || event.pointerType === "touch") return;

			const rect = cover.getBoundingClientRect();
			const x = ((event.clientX - rect.left) / rect.width) * 100;
			const y = ((event.clientY - rect.top) / rect.height) * 100;

			cover.style.setProperty("--water-x", `${x.toFixed(2)}%`);
			cover.style.setProperty("--water-y", `${y.toFixed(2)}%`);
		});

		cover.addEventListener("pointerleave", () => {
			cover.style.setProperty("--water-x", "50%");
			cover.style.setProperty("--water-y", "50%");
		});
	});
</script>
