---
import SectionsLayout from "../../layouts/SectionsLayout.astro";

const PHOTO_IMAGES = [
	"/images/photo/algarve-2025-01.webp",
	"/images/photo/ahmedabad-2024-01.webp",
	"/images/photo/ahmedabad-2024-02.webp",
	"/images/photo/ahmedabad-2024-03.webp",
	"/images/photo/ahmedabad-2024-04.webp",
	"/images/photo/andalusia-2025-01.webp",
	"/images/photo/andalusia-2025-02.webp",
	"/images/photo/new-york-2025-01.webp",
	"/images/photo/barcellona-2025-03.webp",
];

const SIZE_VARIANTS = ["is-base", "is-compact", "is-base", "is-wide"] as const;

const LOCATION_LABELS: Record<string, string> = {
	algarve: "Algarve",
	ahmedabad: "Ahmedabad",
	andalusia: "Andalusia",
	"new-york": "New York",
	barcellona: "Barcelona",
};

const photos = PHOTO_IMAGES.map((src, index) => {
	const filename = decodeURIComponent(src.split("/").pop() ?? "");
	const slug = filename.replace(/\.(jpe?g|png|webp|heic)$/i, "");
	const match = slug.match(/^(.*)-(\d{4})-(\d{2})$/i);
	const locationKey = match?.[1] ?? slug;
	const year = match?.[2]?.slice(-2) ?? "";
	const sequence = match?.[3] ?? "";

	return {
		src,
		code: year && sequence ? `${year}.${sequence}` : slug,
		location: LOCATION_LABELS[locationKey] ?? locationKey,
		variant: SIZE_VARIANTS[index % SIZE_VARIANTS.length],
	};
});
---

<SectionsLayout title="photo | isidoro pannitti architetto" section="photo" lang="en" lockMobileScrollY>
	<div class="gallery-stage" aria-label="Photo sequence">
		<div class="gallery" aria-label="Photo sequence">
			{
				photos.map((photo, index) => (
					<figure class:list={["preview", photo.variant]}>
						<input class="location-toggle" type="checkbox" id={`photo-toggle-en-${index}`} />
						<label class="photo-trigger" for={`photo-toggle-en-${index}`}>
							<img src={encodeURI(photo.src)} alt={photo.location} loading="eager" />
						</label>
						<figcaption>
							<span>{photo.code}</span>
							<span class="location-label" aria-live="polite">{photo.location}</span>
						</figcaption>
					</figure>
				))
			}
		</div>
	</div>
</SectionsLayout>

<style>
	.gallery-stage {
		width: 100%;
	}

	.gallery {
		display: flex;
		align-items: flex-start;
		flex-wrap: nowrap;
		box-sizing: border-box;
		width: calc(100% + (var(--edge) * 2));
		gap: clamp(0.75rem, 1.8vw, 1.2rem);
		margin-inline: calc(var(--edge) * -1);
		overflow-x: auto;
		overscroll-behavior-x: contain;
		padding-left: var(--edge);
		padding-right: 0;
		scroll-padding-left: var(--edge);
		scroll-snap-type: x mandatory;
		touch-action: pan-x;
		-webkit-overflow-scrolling: touch;
		padding-bottom: 0.45rem;
		scrollbar-width: none;
		-ms-overflow-style: none;
	}

	.gallery::-webkit-scrollbar {
		width: 0;
		height: 0;
		display: none;
	}

	.preview {
		flex: 0 0 auto;
		margin: 0;
		display: grid;
		gap: 0.45rem;
		scroll-snap-align: start;
	}

	.location-toggle {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}

	.photo-trigger {
		display: block;
		cursor: pointer;
	}

	.preview img {
		display: block;
		width: 17rem;
		height: auto;
	}

	.preview.is-compact img {
		width: 14.8rem;
	}

	.preview.is-wide img {
		width: 19.4rem;
	}

	.preview figcaption {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		max-width: 100%;
		overflow-wrap: anywhere;
	}

	.location-label {
		opacity: 0;
		transform: translateY(0.08rem);
		transition: opacity 220ms ease, transform 220ms ease;
	}

	.location-toggle:checked ~ figcaption .location-label {
		opacity: 1;
		transform: translateY(0);
	}

	@media (max-width: 760px) {
		.gallery-stage {
			--mobile-photo-height: min(
				clamp(20.25rem, 52svh, 26rem),
				calc(100svh - clamp(6.9rem, 17vh, 9.5rem) - 6.55rem - env(safe-area-inset-bottom, 0px))
			);
			flex: 1 1 auto;
			height: auto;
			min-height: 0;
			display: flex;
			align-items: flex-start;
			overflow-x: auto;
			overflow-y: hidden;
			overscroll-behavior-x: contain;
			overscroll-behavior-y: none;
			scroll-snap-type: x mandatory;
			touch-action: pan-x;
			-webkit-overflow-scrolling: touch;
			box-sizing: border-box;
			padding-bottom: max(1.7rem, calc(env(safe-area-inset-bottom, 0px) + 1.1rem));
			scrollbar-width: none;
			-ms-overflow-style: none;
		}

		.gallery-stage::-webkit-scrollbar {
			width: 0;
			height: 0;
			display: none;
		}

		.gallery {
			width: max-content;
			min-width: max-content;
			overflow: visible;
			margin-inline: 0;
			padding-left: 11vw;
			padding-right: 11vw;
			padding-bottom: 0;
		}

		.preview {
			scroll-snap-align: center;
		}

		.preview {
			width: clamp(16rem, 78vw, 22rem);
		}

		.preview.is-compact {
			width: clamp(14.25rem, 69vw, 19.5rem);
		}

		.preview.is-wide {
			width: clamp(17rem, 82vw, 23.5rem);
		}

		.preview:first-child {
			margin-left: calc(var(--edge) - 11vw);
			scroll-snap-align: start;
		}

		.preview:last-child {
			margin-right: calc(var(--edge) - 11vw);
			scroll-snap-align: end;
		}

		.preview img {
			width: 100%;
			height: var(--mobile-photo-height);
			aspect-ratio: auto;
			object-fit: cover;
		}

		.preview figcaption {
			min-height: 1.55rem;
		}
	}
</style>
