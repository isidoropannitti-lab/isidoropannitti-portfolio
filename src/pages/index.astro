---
import SectionsLayout from "../layouts/SectionsLayout.astro";

const ARCHITECTURE_IMAGES = [
	{ src: "/images/architecture/23.4-cover.webp", label: "23.4", slug: "23-4", variant: "is-base", hoverTitle: "Helene Binet, natura tempo e architettura" },
	{ src: "/images/architecture/25-1-cover.webp", label: "25.1", slug: "25-1", variant: "is-base", hoverTitle: "Proposta di progetto per AMA" },
	{ src: "/images/architecture/25-2-cover.webp", label: "25.2", slug: "25-2", variant: "is-base", hoverTitle: "Milano, Private residence" },
	{ src: "/images/architecture/25-3-cover.webp", label: "25.3", onGoing: true, variant: "is-wide", hoverTitle: "In corso" },
	{ src: "/images/architecture/25-4-cover.webp", label: "25.4", slug: "25-4", variant: "is-compact", hoverTitle: "Infinite/Unfinished" },
	{ src: "/images/architecture/25-6-cover.webp", label: "25.6", slug: "25-6", variant: "is-base", hoverTitle: "Roma, Private residence" },
	{ src: "/images/architecture/25-8-cover.webp", label: "25.8", onGoing: true, variant: "is-base", hoverTitle: "In corso" },
	{ src: "/images/architecture/26-2-cover.jpeg", label: "26.2", slug: "26-2", variant: "is-wide", hoverTitle: "Metafisica / Metafisiche" },
];
---

<SectionsLayout title="isidoro pannitti architetto" section="architecture" lang="it" lockMobileScrollY>
	<div
		class="gallery-stage"
		data-home-gallery-stage
		data-reset-gallery
		aria-label="Architecture sequence"
	>
		<div class="gallery" data-home-gallery aria-label="Architecture sequence">
			{
				ARCHITECTURE_IMAGES.map((image) => (
					<figure class:list={["preview", image.variant]}>
						{
							image.onGoing ? (
								<>
									<input
										class="ongoing-toggle"
										type="checkbox"
										id={`ongoing-${image.label.replace(".", "-")}`}
									/>
									<label
										class="project-link ongoing-trigger magnetic-target pressable"
										for={`ongoing-${image.label.replace(".", "-")}`}
										data-cursor-title={image.hoverTitle}
										data-magnetic
									>
										<img src={image.src} alt={image.label} loading="eager" />
									</label>
								</>
							) : image.slug ? (
								<a href={`/projects/${image.slug}`} class="project-link magnetic-target pressable" data-cursor-title={image.hoverTitle} data-magnetic>
									<img src={image.src} alt={image.label} loading="eager" />
								</a>
							) : (
								<img class="magnetic-target pressable" src={image.src} alt={image.label} loading="eager" data-cursor-title={image.hoverTitle} data-magnetic />
							)
						}
						<figcaption>
							<span>{image.label}</span>
							{
								image.onGoing && (
									<span class="ongoing-label" aria-live="polite">in corso</span>
								)
							}
						</figcaption>
					</figure>
				))
			}
		</div>
	</div>
</SectionsLayout>

<style>
	.gallery-stage {
		width: 100%;
	}

	.gallery {
		display: flex;
		align-items: flex-start;
		flex-wrap: nowrap;
		box-sizing: border-box;
		width: calc(100% + (var(--edge) * 2));
		gap: var(--space-16);
		margin-top: calc(var(--space-8) * -1);
		margin-inline: calc(var(--edge) * -1);
		overflow-x: auto;
		overscroll-behavior-x: contain;
		padding-top: var(--space-8);
		padding-left: var(--edge);
		padding-right: var(--edge);
		scroll-padding-left: var(--edge);
		scroll-snap-type: x proximity;
		touch-action: pan-x;
		-webkit-overflow-scrolling: touch;
		padding-bottom: var(--space-8);
		scrollbar-width: none;
		-ms-overflow-style: none;
	}

	.gallery::-webkit-scrollbar {
		width: 0;
		height: 0;
		display: none;
	}

	.preview {
		flex: 0 0 auto;
		margin: 0;
		display: grid;
		gap: var(--space-16);
		scroll-snap-align: start;
	}

	.preview img {
		display: block;
		width: auto;
		height: clamp(23rem, 38vw, 28rem);
		object-fit: cover;
		object-position: center;
	}

	.project-link {
		display: block;
	}

	[data-cursor-title] {
		cursor: none;
	}

	:global(.project-title-cursor) {
		position: fixed;
		z-index: 1000;
		top: 0;
		left: 0;
		max-width: min(18rem, calc(100vw - var(--space-32)));
		color: var(--color-text);
		font: inherit;
		line-height: 1.05;
		opacity: 0;
		pointer-events: none;
		transform: translate3d(var(--cursor-x, 0), var(--cursor-y, 0), 0);
		transition: opacity 120ms ease;
		white-space: normal;
	}

	:global(.project-title-cursor.is-visible) {
		opacity: 1;
	}

	.ongoing-toggle {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}

	.ongoing-trigger {
		cursor: pointer;
	}

	.preview figcaption {
		display: flex;
		align-items: baseline;
		gap: var(--space-8);
	}

	.ongoing-label {
		opacity: 0;
		transform: translateY(var(--space-4));
		transition: opacity 320ms ease, transform 360ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.ongoing-toggle:checked ~ figcaption .ongoing-label {
		opacity: 1;
		transform: translateY(0);
	}

	.ongoing-trigger img {
		pointer-events: none;
	}

	@media (max-width: 760px) {
		.gallery-stage {
			--mobile-card-width: clamp(16rem, 72vw, 20rem);
			--mobile-caption-space: var(--space-64);
			--mobile-card-height: min(
				clamp(24rem, 58svh, 30rem),
				calc(
					100svh - var(--mobile-main-top) - var(--mobile-main-bottom) -
						var(--mobile-caption-space) - var(--space-16) - env(safe-area-inset-bottom, 0px)
				)
			);
			flex: 1 1 auto;
			height: auto;
			min-height: 0;
			display: flex;
			align-items: flex-start;
			overflow-x: auto;
			overflow-y: hidden;
			overscroll-behavior-x: contain;
			overscroll-behavior-y: none;
			scroll-snap-type: x mandatory;
			scroll-padding-left: 0;
			touch-action: pan-x;
			-webkit-overflow-scrolling: touch;
			box-sizing: border-box;
			margin-top: calc(var(--space-8) * -1);
			padding: var(--space-8) calc((100% - var(--mobile-card-width)) / 2)
				max(var(--space-32), calc(env(safe-area-inset-bottom, 0px) + var(--space-24))) 0;
			scrollbar-width: none;
			-ms-overflow-style: none;
		}

		.gallery-stage::-webkit-scrollbar {
			width: 0;
			height: 0;
			display: none;
		}

		.gallery {
			width: max-content;
			min-width: max-content;
			align-self: flex-start;
			overflow: visible;
			margin-inline: 0;
			padding: 0 var(--edge) 0 0;
		}

		.preview {
			width: var(--mobile-card-width);
			scroll-snap-align: center;
		}

		.preview:first-child {
			scroll-snap-align: start;
		}

		.preview.is-compact {
			width: var(--mobile-card-width);
		}

		.preview.is-wide {
			width: var(--mobile-card-width);
		}

		.preview img {
			width: 100%;
			height: var(--mobile-card-height);
			aspect-ratio: auto;
			object-fit: cover;
		}

		.preview figcaption {
			min-height: var(--mobile-caption-space);
			padding-bottom: var(--space-8);
		}

		[data-cursor-title] {
			cursor: pointer;
		}
	}
</style>

<script>
	const hoverTargets = Array.from(document.querySelectorAll("[data-cursor-title]"));

	if (hoverTargets.length > 0 && window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
		const cursor = document.createElement("div");
		cursor.className = "project-title-cursor";
		cursor.setAttribute("aria-hidden", "true");
		document.body.append(cursor);

		const moveCursor = (event: PointerEvent) => {
			cursor.style.setProperty("--cursor-x", `${event.clientX}px`);
			cursor.style.setProperty("--cursor-y", `${event.clientY}px`);
		};

		for (const target of hoverTargets) {
			target.addEventListener("pointerenter", (event) => {
				const title = target.getAttribute("data-cursor-title");
				if (!title) return;

				cursor.textContent = title;
				moveCursor(event as PointerEvent);
				cursor.classList.add("is-visible");
			});

			target.addEventListener("pointermove", (event) => {
				moveCursor(event as PointerEvent);
			});

			target.addEventListener("pointerleave", () => {
				cursor.classList.remove("is-visible");
			});
		}
	}
</script>
