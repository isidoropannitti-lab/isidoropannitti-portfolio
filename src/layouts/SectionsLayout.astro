---
import Analytics from "@vercel/analytics/astro";

type Section = "architecture" | "photo" | "info";
type Lang = "it" | "en";

export interface Props {
	title: string;
	section: Section;
	lang?: Lang;
	lockMobileScrollY?: boolean;
}

const { title, section, lang = "it", lockMobileScrollY = false } = Astro.props;

const EMAIL = "isidoro.pannitti@gmail.com";
const INSTAGRAM_HANDLE = "@_isoradio";
const INSTAGRAM_URL = "https://www.instagram.com/_isoradio/";

const navLabels: Record<Lang, Record<Section, string>> = {
	it: {
		architecture: "architettura",
		photo: "foto",
		info: "info",
	},
	en: {
		architecture: "architecture",
		photo: "photo",
		info: "info",
	},
};

const prefix = lang === "en" ? "/en" : "";
const getSectionHref = (target: Section) => {
	if (target === "architecture") {
		return prefix || "/";
	}

	return `${prefix}/${target}`;
};

const pathname = Astro.url.pathname;
const englishPath = pathname.startsWith("/en") ? pathname : `/en${pathname === "/" ? "" : pathname}`;
const italianPath = pathname.startsWith("/en") ? pathname.slice(3) || "/" : pathname;
const switchHref = lang === "it" ? englishPath : italianPath;
---

<html
	lang={lang}
	class:list={{
		"lock-mobile-scroll-y": lockMobileScrollY,
		"theme-photo": section === "photo",
		"theme-paper": section !== "photo",
	}}
>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Work+Sans:ital,wght@0,300;1,300&display=swap"
			rel="stylesheet"
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=ip2" />
		<link rel="shortcut icon" href="/favicon.svg?v=ip2" />
		<title>{title}</title>
		<style>
			:root {
				color-scheme: light;
				--space-4: 4px;
				--space-8: 8px;
				--space-12: 12px;
				--space-16: 16px;
				--space-24: 24px;
				--space-32: 32px;
				--space-48: 48px;
				--space-64: 64px;
				--space-96: 96px;
				--space-128: 128px;
				--edge: var(--space-48);
				--paper-bg: #faf9f7;
				--photo-bg: #000;
				--photo-text: #d8d1c5;
			}

			* {
				box-sizing: border-box;
			}

			html,
			body {
				margin: 0;
				padding: 0;
				background: #fff;
				color: #000;
				overflow-x: hidden;
				font-family: "Work Sans", sans-serif;
				font-weight: 300;
				font-size: clamp(0.98rem, 1.05vw, 1rem);
				line-height: 1.45;
			}

			html.theme-photo,
			body.theme-photo {
				background: var(--photo-bg);
				color: var(--photo-text);
			}

			html.theme-paper,
			body.theme-paper {
				background: var(--paper-bg);
			}

			a {
				color: inherit;
				text-decoration: none;
				transition: opacity 200ms ease;
			}

			a:hover,
			a:focus-visible {
				opacity: 0.68;
			}

			main img {
				opacity: 0;
				animation: image-fade-in 0.65s cubic-bezier(0.22, 1, 0.36, 1) forwards;
			}

			.left-fixed,
			.right-fixed {
				position: fixed;
				top: var(--edge);
				z-index: 10;
			}

			.menu-toggle {
				position: fixed;
				opacity: 0;
				pointer-events: none;
			}

			.left-fixed {
				left: var(--edge);
				display: grid;
				gap: var(--space-4);
				color: #fff;
				mix-blend-mode: difference;
				text-transform: lowercase;
				transition: transform 360ms cubic-bezier(0.22, 1, 0.36, 1), opacity 320ms ease;
			}

			body.theme-photo .left-fixed {
				color: var(--photo-text);
				mix-blend-mode: normal;
			}

			.left-fixed p {
				margin: 0;
			}

			.site-home {
				display: inline-block;
			}

			:global(.magnetic-target) {
				--magnet-x: 0px;
				--magnet-y: 0px;
				transform: translate3d(var(--magnet-x), var(--magnet-y), 0);
				transition: transform 420ms cubic-bezier(0.2, 1, 0.34, 1);
			}

			:global([data-section-flow]) {
				--section-brake-x: 0px;
			}

			.left-fixed a,
			.sections-nav a,
			.sections-nav span {
				display: inline-block;
			}

			.right-fixed {
				right: var(--edge);
				text-transform: lowercase;
				display: flex;
				align-items: center;
				justify-content: flex-end;
				gap: var(--space-8);
			}

			body.theme-photo .right-fixed {
				color: var(--photo-text);
			}

			.sections-nav {
				display: flex;
				align-items: center;
				gap: 0;
			}

			.right-fixed .active {
				font-style: italic;
			}

			.menu-trigger {
				--menu-rotation: 0deg;
				display: none;
				cursor: pointer;
				user-select: none;
				font-size: 1.3em;
				line-height: 1;
				transform-origin: 50% 52%;
				transform: rotate(var(--menu-rotation));
				transition: opacity 280ms ease, transform 520ms cubic-bezier(0.2, 1, 0.34, 1);
				will-change: transform;
			}

			main {
				min-height: 100vh;
				padding: calc(var(--space-128) + var(--space-32)) var(--edge) var(--space-32);
				overflow-x: clip;
				touch-action: pan-y;
			}

			.lang-switch-fixed {
				position: fixed;
				right: var(--edge);
				bottom: var(--edge);
				z-index: 20;
				color: #b9b9b9;
				transition: opacity 260ms ease;
			}

			body.theme-photo .lang-switch-fixed {
				color: color-mix(in srgb, var(--photo-text) 72%, transparent);
			}

			.lang-switch-fixed.is-hidden {
				opacity: 0;
				pointer-events: none;
			}

			.lang-switch-fixed a {
				color: inherit;
				text-transform: lowercase;
			}

			.lang-switch-fixed .active {
				color: #9b9b9b;
			}

			body.theme-photo .lang-switch-fixed .active {
				color: var(--photo-text);
			}

			.page-transition-overlay {
				position: fixed;
				inset: 0;
				z-index: 80;
				background: #fff;
				opacity: 0;
				pointer-events: none;
				transition: opacity 460ms ease;
			}

			.page-transition-overlay.is-dark {
				background: var(--photo-bg);
			}

			.page-transition-overlay.is-active {
				opacity: 1;
			}

			@media (max-width: 980px) {
				:root {
					--edge: var(--space-8);
				}

				html,
				body {
					font-size: clamp(0.88rem, 3.5vw, 0.95rem);
				}

				html.lock-mobile-scroll-y,
				body.lock-mobile-scroll-y {
					height: 100svh;
					overflow: hidden;
					overscroll-behavior: none;
				}

				body.lock-mobile-scroll-y {
					position: fixed;
					inset: 0;
					width: 100%;
				}

				body.lock-mobile-scroll-y main {
					--mobile-main-top: var(--space-128);
					--mobile-main-bottom: var(--space-16);
					--mobile-caption-space: var(--space-48);
					min-height: 0;
					padding-top: var(--mobile-main-top);
					padding-bottom: var(--mobile-main-bottom);
					height: 100svh;
					display: flex;
					flex-direction: column;
					overflow-y: hidden;
					overscroll-behavior-y: none;
					touch-action: pan-x;
				}

				.menu-trigger {
					display: inline-flex;
					align-items: center;
					justify-content: center;
					width: 1em;
					height: 1em;
				}

				.sections-nav {
					max-width: 0;
					overflow: hidden;
					transform: translateX(var(--space-8));
					opacity: 0;
					pointer-events: none;
					transition: transform 360ms cubic-bezier(0.22, 1, 0.36, 1), opacity 320ms ease,
						max-width 360ms cubic-bezier(0.22, 1, 0.36, 1),
						margin-right 360ms cubic-bezier(0.22, 1, 0.36, 1);
					margin-right: 0;
					white-space: nowrap;
				}

				.menu-toggle:checked ~ .left-fixed {
					transform: translateX(calc(var(--space-32) * -1));
					opacity: 0.4;
				}

				.menu-toggle:checked ~ .right-fixed .sections-nav {
					transform: translateX(0);
					opacity: 1;
					pointer-events: auto;
					max-width: 92vw;
					margin-right: var(--space-8);
				}

				.menu-toggle:checked ~ .right-fixed .menu-trigger {
					--menu-rotation: 45deg;
				}

			}

			@media (pointer: fine) {
				:global(.magnetic-target) {
					will-change: transform;
				}
			}

			@media (min-width: 981px) and (pointer: fine) {
				:global([data-section-flow] .gallery) {
					padding-right: var(--space-128);
					transform: translate3d(var(--section-brake-x), 0, 0);
					transition: transform 520ms cubic-bezier(0.18, 1.06, 0.28, 1);
				}
			}

			@media (max-width: 980px) and (pointer: coarse) {
				:global([data-section-flow] .gallery) {
					transform: translate3d(var(--section-brake-x), 0, 0);
					transition: transform 460ms cubic-bezier(0.18, 1.06, 0.28, 1);
				}
			}

			@keyframes image-fade-in {
				from {
					opacity: 0;
				}

				to {
					opacity: 1;
				}
			}
		</style>
	</head>
	<body
		class:list={{
			"lock-mobile-scroll-y": lockMobileScrollY,
			"theme-photo": section === "photo",
			"theme-paper": section !== "photo",
		}}
	>
		<div class="page-transition-overlay" aria-hidden="true" data-page-transition></div>
		<input class="menu-toggle" type="checkbox" id="sections-toggle" />

		<div class="left-fixed">
			<p>
				<a class="site-home" href={prefix || "/"}
					>isidoro pannitti architetto</a
				>
			</p>
			<p>
				<a href={`mailto:${EMAIL}`}>{EMAIL}</a>
			</p>
			<p>
				<a href={INSTAGRAM_URL} target="_blank" rel="noreferrer noopener"
					>{INSTAGRAM_HANDLE}</a
				>
			</p>
		</div>

		<div class="right-fixed">
			<nav class="sections-nav" aria-label="Sections">
				<a
					class:list={{ active: section === "architecture" }}
					href={getSectionHref("architecture")}
					>{navLabels[lang].architecture}</a
				>
				<span>,&nbsp;</span>
				<a
					class:list={{ active: section === "photo" }}
					href={getSectionHref("photo")}
					>{navLabels[lang].photo}</a
				>
				<span>,&nbsp;</span>
				<a
					class:list={{ active: section === "info" }}
					href={getSectionHref("info")}
					>{navLabels[lang].info}</a
				>
			</nav>
			<label class="menu-trigger" for="sections-toggle" aria-label="Toggle navigation"
				>+</label
			>
		</div>

		<div class="lang-switch-fixed" data-lang-switch>
			<a href={switchHref}>
				<span class:list={{ active: lang === "it" }}>it</span>/<span class:list={{ active: lang === "en" }}
					>en</span
				>
			</a>
		</div>

		<main>
			<slot />
		</main>

		<script is:inline>
			(() => {
				const langSwitch = document.querySelector("[data-lang-switch]");
				if (!langSwitch) return;

				let revealTimer;
				const hide = () => langSwitch.classList.add("is-hidden");
				const showLater = () => {
					clearTimeout(revealTimer);
					revealTimer = window.setTimeout(() => {
						langSwitch.classList.remove("is-hidden");
					}, 700);
				};

				const onScrollIntent = () => {
					hide();
					showLater();
				};

				window.addEventListener("wheel", onScrollIntent, { passive: true });
				window.addEventListener("touchmove", onScrollIntent, { passive: true });
				document.addEventListener("scroll", onScrollIntent, { passive: true, capture: true });
			})();

			(() => {
				const menuToggle = document.querySelector("#sections-toggle");
				const nav = document.querySelector(".sections-nav");
				if (!(menuToggle instanceof HTMLInputElement) || !(nav instanceof HTMLElement)) return;

				nav.addEventListener("click", (event) => {
					const target = event.target;
					if (!(target instanceof Element)) return;
					if (target.closest("a")) {
						menuToggle.checked = false;
					}
				});
			})();

			(() => {
				const supportsFinePointer = window.matchMedia("(pointer: fine)");
				if (!supportsFinePointer.matches) return;

				const targets = Array.from(document.querySelectorAll("[data-magnetic]")).filter(
					(target) => target instanceof HTMLElement
				);
				if (!targets.length) return;

				const maxShift = 2;
				const easing = 0.12;
				let activeTarget = null;
				let frame = 0;
				let latestEvent = null;
				let currentX = 0;
				let currentY = 0;
				let targetX = 0;
				let targetY = 0;

				const resetTarget = (target) => {
					target.style.setProperty("--magnet-x", "0px");
					target.style.setProperty("--magnet-y", "0px");
				};

				const startAnimation = () => {
					if (!frame) frame = window.requestAnimationFrame(updateActiveTarget);
				};

				const updateActiveTarget = () => {
					frame = 0;
					if (!activeTarget) return;

					currentX += (targetX - currentX) * easing;
					currentY += (targetY - currentY) * easing;
					activeTarget.style.setProperty("--magnet-x", `${currentX.toFixed(2)}px`);
					activeTarget.style.setProperty("--magnet-y", `${currentY.toFixed(2)}px`);

					const isSettled = Math.abs(targetX - currentX) < 0.02 && Math.abs(targetY - currentY) < 0.02;
					if (!isSettled) {
						startAnimation();
						return;
					}

					currentX = targetX;
					currentY = targetY;
					activeTarget.style.setProperty("--magnet-x", `${currentX.toFixed(2)}px`);
					activeTarget.style.setProperty("--magnet-y", `${currentY.toFixed(2)}px`);
					if (!latestEvent && targetX === 0 && targetY === 0) activeTarget = null;
				};

				targets.forEach((target) => {
					target.addEventListener("pointerenter", () => {
						if (activeTarget && activeTarget !== target) resetTarget(activeTarget);
						activeTarget = target;
						currentX = 0;
						currentY = 0;
						targetX = 0;
						targetY = 0;
					});

					target.addEventListener("pointermove", (event) => {
						if (activeTarget !== target) return;
						latestEvent = event;
						const rect = activeTarget.getBoundingClientRect();
						const centerX = rect.left + rect.width / 2;
						const centerY = rect.top + rect.height / 2;
						const deltaX = latestEvent.clientX - centerX;
						const deltaY = latestEvent.clientY - centerY;
						const normalizedX = Math.max(-1, Math.min(1, deltaX / Math.max(rect.width / 2, 1)));
						const normalizedY = Math.max(-1, Math.min(1, deltaY / Math.max(rect.height / 2, 1)));
						targetX = normalizedX * maxShift;
						targetY = normalizedY * maxShift;
						startAnimation();
					});

					target.addEventListener("pointerleave", () => {
						if (activeTarget !== target) return;
						latestEvent = null;
						targetX = 0;
						targetY = 0;
						startAnimation();
					});
				});

				window.addEventListener("blur", () => {
					targets.forEach(resetTarget);
					activeTarget = null;
				});
			})();

			(() => {
				const supportsTouch = window.matchMedia("(pointer: coarse)");
				if (!supportsTouch.matches) return;

				const targets = Array.from(document.querySelectorAll("[data-magnetic]")).filter(
					(target) => target instanceof HTMLElement
				);
				if (!targets.length) return;

				const maxShift = 2;
				const releaseDelay = 180;

				const resetTarget = (target) => {
					target.style.setProperty("--magnet-x", "0px");
					target.style.setProperty("--magnet-y", "0px");
				};

				targets.forEach((target) => {
					let releaseTimer;
					let startX = 0;
					let startY = 0;

					target.addEventListener(
						"touchstart",
						(event) => {
							const touch = event.touches[0];
							if (!touch) return;

							window.clearTimeout(releaseTimer);
							startX = touch.clientX;
							startY = touch.clientY;
						},
						{ passive: true }
					);

					target.addEventListener(
						"touchmove",
						(event) => {
							const touch = event.touches[0];
							if (!touch) return;

							const movementX = touch.clientX - startX;
							const movementY = touch.clientY - startY;
							if (Math.hypot(movementX, movementY) < 4) return;

							const rect = target.getBoundingClientRect();
							const centerX = rect.left + rect.width / 2;
							const centerY = rect.top + rect.height / 2;
							const deltaX = touch.clientX - centerX;
							const deltaY = touch.clientY - centerY;
							const distance = Math.max(Math.hypot(deltaX, deltaY), 1);
							const shiftX = (deltaX / distance) * maxShift;
							const shiftY = (deltaY / distance) * maxShift;

							target.style.setProperty("--magnet-x", `${shiftX.toFixed(2)}px`);
							target.style.setProperty("--magnet-y", `${shiftY.toFixed(2)}px`);
						},
						{ passive: true }
					);

					const release = () => {
						window.clearTimeout(releaseTimer);
						releaseTimer = window.setTimeout(() => resetTarget(target), releaseDelay);
					};

					target.addEventListener("touchend", release, { passive: true });
					target.addEventListener("touchcancel", () => resetTarget(target), { passive: true });
				});
			})();

			(() => {
				if (!document.body.classList.contains("lock-mobile-scroll-y")) return;
				if (!window.matchMedia("(max-width: 980px)").matches) return;

				let startX = 0;
				let startY = 0;

				window.addEventListener(
					"touchstart",
					(event) => {
						const touch = event.touches[0];
						if (!touch) return;
						startX = touch.clientX;
						startY = touch.clientY;
					},
					{ passive: true }
				);

				window.addEventListener(
					"touchmove",
					(event) => {
						const touch = event.touches[0];
						if (!touch) return;

						const deltaX = Math.abs(touch.clientX - startX);
						const deltaY = Math.abs(touch.clientY - startY);

						if (deltaY > deltaX) {
							event.preventDefault();
						}
					},
					{ passive: false }
				);
			})();

			(() => {
				const supportsDesktopFlow = window.matchMedia("(min-width: 981px) and (pointer: fine)");
				if (!supportsDesktopFlow.matches) return;

				const stages = Array.from(document.querySelectorAll("[data-section-flow]")).filter(
					(stage) => stage instanceof HTMLElement
				);
				if (!stages.length) return;

				const overlay = document.querySelector("[data-page-transition]");
				const storageKey = "section-transition-theme";
				const threshold = 220;
				const maxBrake = 48;
				const resetDelay = 280;
				let isNavigating = false;

				const resolveTheme = (pathname) => {
					const normalized = pathname.replace(/\/+$/, "") || "/";
					return normalized === "/photo" || normalized === "/en/photo" ? "dark" : "light";
				};

				const setOverlayTheme = (theme) => {
					if (!(overlay instanceof HTMLElement)) return;
					overlay.classList.toggle("is-dark", theme === "dark");
				};

				const navigateSoftly = (href) => {
					if (isNavigating) return;
					isNavigating = true;

					const url = new URL(href, window.location.href);
					sessionStorage.setItem(storageKey, resolveTheme(url.pathname));
					setOverlayTheme(resolveTheme(url.pathname));

					if (overlay instanceof HTMLElement) {
						overlay.classList.add("is-active");
					}

					window.setTimeout(() => {
						window.location.href = url.toString();
					}, 360);
				};

				stages.forEach((stage) => {
					const nextHref = stage.dataset.nextSectionHref;
					const scroller = stage.querySelector(".gallery");
					if (!nextHref || !(scroller instanceof HTMLElement)) return;

					let pull = 0;
					let resetTimer;

					const maxScroll = () => Math.max(scroller.scrollWidth - scroller.clientWidth, 0);
					const releaseBrake = () => {
						pull = 0;
						stage.style.setProperty("--section-brake-x", "0px");
					};
					const snapBackToEnd = () => {
						releaseBrake();
						scroller.scrollTo({ left: maxScroll(), behavior: "smooth" });
					};

					scroller.addEventListener(
						"wheel",
						(event) => {
							if (isNavigating) {
								event.preventDefault();
								return;
							}

							const intent = Math.abs(event.deltaX) > Math.abs(event.deltaY) ? event.deltaX : event.deltaY;
							if (intent <= 0) {
								window.clearTimeout(resetTimer);
								releaseBrake();
								return;
							}

							const atEnd = scroller.scrollLeft >= maxScroll() - 2;
							if (!atEnd) return;

							event.preventDefault();
							window.clearTimeout(resetTimer);

							pull = Math.min(threshold, pull + Math.abs(intent));
							const easedPull = 1 - Math.pow(1 - pull / threshold, 2.1);
							const brake = -Math.min(maxBrake, easedPull * maxBrake);
							stage.style.setProperty("--section-brake-x", `${brake.toFixed(2)}px`);

							if (pull >= threshold) {
								navigateSoftly(nextHref);
								return;
							}

							resetTimer = window.setTimeout(snapBackToEnd, resetDelay);
						},
						{ passive: false }
					);

					stage.addEventListener("mouseleave", () => {
						window.clearTimeout(resetTimer);
						releaseBrake();
					});
				});
			})();

			(() => {
				const supportsMobileFlow = window.matchMedia("(max-width: 980px) and (pointer: coarse)");
				if (!supportsMobileFlow.matches) return;

				const stages = Array.from(document.querySelectorAll("[data-section-flow]")).filter(
					(stage) => stage instanceof HTMLElement
				);
				if (!stages.length) return;

				const overlay = document.querySelector("[data-page-transition]");
				const storageKey = "section-transition-theme";
				const threshold = 96;
				const maxBrake = 28;
				const resetDelay = 220;
				let isNavigating = false;

				const resolveTheme = (pathname) => {
					const normalized = pathname.replace(/\/+$/, "") || "/";
					return normalized === "/photo" || normalized === "/en/photo" ? "dark" : "light";
				};

				const setOverlayTheme = (theme) => {
					if (!(overlay instanceof HTMLElement)) return;
					overlay.classList.toggle("is-dark", theme === "dark");
				};

				const navigateSoftly = (href) => {
					if (isNavigating) return;
					isNavigating = true;

					const url = new URL(href, window.location.href);
					sessionStorage.setItem(storageKey, resolveTheme(url.pathname));
					setOverlayTheme(resolveTheme(url.pathname));

					if (overlay instanceof HTMLElement) {
						overlay.classList.add("is-active");
					}

					window.setTimeout(() => {
						window.location.href = url.toString();
					}, 340);
				};

				stages.forEach((stage) => {
					const nextHref = stage.dataset.nextSectionHref;
					const gallery = stage.querySelector(".gallery");
					if (!nextHref || !(gallery instanceof HTMLElement)) return;

					let pull = 0;
					let resetTimer;
					let startX = 0;
					let startY = 0;
					let lastX = 0;

					const maxScroll = () => Math.max(stage.scrollWidth - stage.clientWidth, 0);
					const releaseBrake = () => {
						pull = 0;
						stage.style.setProperty("--section-brake-x", "0px");
					};
					const releaseLater = () => {
						window.clearTimeout(resetTimer);
						resetTimer = window.setTimeout(releaseBrake, resetDelay);
					};

					stage.addEventListener(
						"touchstart",
						(event) => {
							const touch = event.touches[0];
							if (!touch) return;

							window.clearTimeout(resetTimer);
							startX = touch.clientX;
							startY = touch.clientY;
							lastX = touch.clientX;
						},
						{ passive: true }
					);

					stage.addEventListener(
						"touchmove",
						(event) => {
							if (isNavigating) {
								event.preventDefault();
								return;
							}

							const touch = event.touches[0];
							if (!touch) return;

							const movementX = touch.clientX - startX;
							const movementY = touch.clientY - startY;
							const intent = lastX - touch.clientX;
							lastX = touch.clientX;

							if (Math.abs(movementY) > Math.abs(movementX)) return;

							if (intent <= 0) {
								window.clearTimeout(resetTimer);
								releaseBrake();
								return;
							}

							const atEnd = stage.scrollLeft >= maxScroll() - 2;
							if (!atEnd) return;

							event.preventDefault();
							window.clearTimeout(resetTimer);

							pull = Math.min(threshold, pull + Math.abs(intent));
							const easedPull = 1 - Math.pow(1 - pull / threshold, 2.1);
							const brake = -Math.min(maxBrake, easedPull * maxBrake);
							stage.style.setProperty("--section-brake-x", `${brake.toFixed(2)}px`);

							if (pull >= threshold) {
								navigateSoftly(nextHref);
								return;
							}

							releaseLater();
						},
						{ passive: false }
					);

					stage.addEventListener("touchend", releaseLater, { passive: true });
					stage.addEventListener("touchcancel", releaseBrake, { passive: true });
				});
			})();

			(() => {
				const overlay = document.querySelector("[data-page-transition]");
				if (!(overlay instanceof HTMLElement)) return;

				const storageKey = "section-transition-theme";
				const resolveTheme = (pathname) => {
					const normalized = pathname.replace(/\/+$/, "") || "/";
					return normalized === "/photo" || normalized === "/en/photo" ? "dark" : "light";
				};

				const setTheme = (theme) => {
					overlay.classList.toggle("is-dark", theme === "dark");
				};

				const resetOverlay = () => {
					overlay.classList.remove("is-active");
					overlay.style.transition = "";
				};

				const pendingTheme = sessionStorage.getItem(storageKey);
				if (pendingTheme) {
					sessionStorage.removeItem(storageKey);
					setTheme(pendingTheme);
					overlay.style.transition = "none";
					overlay.classList.add("is-active");

					requestAnimationFrame(() => {
						requestAnimationFrame(() => {
							overlay.style.transition = "opacity 520ms ease";
							overlay.classList.remove("is-active");
						});
					});
				}

				window.addEventListener("pageshow", (event) => {
					if (event.persisted) resetOverlay();
				});
				window.addEventListener("pagehide", resetOverlay);

				document.addEventListener(
					"click",
					(event) => {
						const target = event.target;
						if (!(target instanceof Element)) return;

						const link = target.closest("a");
						if (!(link instanceof HTMLAnchorElement)) return;
						if (event.defaultPrevented) return;
						if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
						if (link.target && link.target !== "_self") return;

						const url = new URL(link.href, window.location.href);
						if (url.origin !== window.location.origin) return;
						if (`${url.pathname}${url.search}${url.hash}` === `${window.location.pathname}${window.location.search}${window.location.hash}`) return;

						const theme = resolveTheme(url.pathname);
						sessionStorage.setItem(storageKey, theme);
						setTheme(theme);
						overlay.classList.add("is-active");
						event.preventDefault();

						window.setTimeout(() => {
							window.location.href = url.toString();
						}, 260);
					},
					true
				);
			})();

		</script>
		<Analytics />
	</body>
</html>
