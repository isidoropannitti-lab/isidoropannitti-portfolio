---
import { getCollection, type CollectionEntry } from "astro:content";
import { readFile, readdir } from "node:fs/promises";
import SectionsLayout from "../../layouts/SectionsLayout.astro";

export async function getStaticPaths() {
	const projects = await getCollection("featuredProjects");

	return projects.map((project) => ({
		params: { slug: project.slug },
		props: { project },
	}));
}

interface Props {
	project: CollectionEntry<"featuredProjects">;
}

const { project } = Astro.props as Props;

const IMAGE_EXTENSIONS = /\.(avif|gif|jpe?g|png|webp)$/i;
const SPAN_PATTERN: Array<"sm" | "md" | "lg"> = ["md", "sm", "lg", "md", "sm", "md"];

const projectFolderUrl = new URL(`../../../public/images/projects/${project.slug}/`, import.meta.url);

const formatCaption = (filename: string) =>
	filename
		.replace(/\.[^.]+$/, "")
		.replace(/[._]+/g, " ")
		.replace(/\s+/g, " ")
		.trim();

const sortByFileName = (a: string, b: string) =>
	a.localeCompare(b, undefined, { numeric: true, sensitivity: "base" });

const isEmphasizedProjectImage = (slug: string, filename: string) =>
	slug === "25-1" && ["25-1-02.webp", "25-1-03.webp"].includes(filename);

const buildProjectImages = async () => {
	try {
		const entries = await readdir(projectFolderUrl, { withFileTypes: true });
		const imageFiles = entries
			.filter((entry) => entry.isFile() && IMAGE_EXTENSIONS.test(entry.name))
			.map((entry) => entry.name)
			.sort(sortByFileName);

		if (imageFiles.length === 0) {
			return project.data.images;
		}

		return imageFiles.map((filename, index) => ({
			src: `/images/projects/${project.slug}/${filename}`,
			alt: `${project.data.title} photo ${index + 1}`,
			caption: formatCaption(filename),
			span: SPAN_PATTERN[index % SPAN_PATTERN.length],
			emphasized: isEmphasizedProjectImage(project.slug, filename),
		}));
	} catch {
		return project.data.images;
	}
};

const readProjectTeaser = async () => {
	try {
		const localized = await readFile(new URL("teaser-it.txt", projectFolderUrl), "utf-8");
		const localizedClean = localized.trim();
		if (localizedClean) return localizedClean;
	} catch {
		// Fallback to default teaser file.
	}

	try {
		const plain = await readFile(new URL("teaser.txt", projectFolderUrl), "utf-8");
		const clean = plain.trim();
		if (clean) return clean;
	} catch {
		// Fallback to rich text if plain text is not available.
	}

	try {
		const rich = await readFile(new URL("teaser.txt.rtf", projectFolderUrl), "utf-8");
		const decoded = rich
			.replace(/\\par[d]?/g, "\n")
			.replace(/\\\r?\n/g, "\n")
			.replace(/\\[a-z]+\d* ?/gi, "")
			.replace(/[{}]/g, "")
			.replace(/\n{3,}/g, "\n\n")
			.trim();

		if (decoded) return decoded;
	} catch {
		// Keep frontmatter teaser if no local file is found.
	}

	return project.data.teaser;
};

const teaser = await readProjectTeaser();
const projectImages = await buildProjectImages();
const heroFallbackSrc = projectImages[0]?.src ?? project.data.cover;

const arrangedProjectImages: Array<
	(typeof projectImages)[number] & { column: "left" | "right"; row: number }
> = [];

let rowCursor = 1;
const totalPairs = Math.ceil(projectImages.length / 2);

for (let pairIndex = 0; pairIndex < totalPairs; pairIndex += 1) {
	const leftImage = projectImages[pairIndex * 2];
	const rightImage = projectImages[pairIndex * 2 + 1];

	let leftRow = rowCursor;
	let rightRow = rowCursor;

	// Occasional unilateral skip to keep rhythm while preserving order.
	if (pairIndex % 4 === 1) {
		rightRow += 1;
	}
	if (pairIndex % 4 === 3) {
		leftRow += 1;
	}

	if (leftImage) {
		arrangedProjectImages.push({
			...leftImage,
			column: "left",
			row: leftRow,
		});
	}
	if (rightImage) {
		arrangedProjectImages.push({
			...rightImage,
			column: "right",
			row: rightRow,
		});
	}

	// Keep one whole empty row between consecutive pairs.
	rowCursor = Math.max(leftRow, rightRow) + 2;

	// Add an additional empty row periodically for a slower vertical rhythm.
	if ((pairIndex + 1) % 3 === 2) {
		rowCursor += 1;
	}
}
---

<SectionsLayout title={`${project.data.title} | isidoro pannitti architetto`} section="architecture" lang="it">
	<article class="project-page">
		<div class="hero-head">
			<figure class="hero">
				<img
					class="magnetic-target pressable"
					src={project.data.cover}
					alt={project.data.coverAlt}
					loading="eager"
					fetchpriority="high"
					decoding="sync"
					data-magnetic
					onerror={`this.onerror=null;this.src='${heroFallbackSrc}'`}
				/>
				<figcaption>
					{project.data.coverCaption}
					{project.data.status && <span class="status-tag">{project.data.status}</span>}
				</figcaption>
			</figure>

			{teaser && <p class="teaser teaser-inline">{teaser}</p>}
		</div>

		<ul class="project-grid" aria-label={`${project.data.title} gallery`}>
			{
				arrangedProjectImages.map((image) => (
					<li
						class:list={[
							"grid-item",
							image.column === "right" && "is-right",
							image.emphasized && "is-emphasized",
						]}
						style={`--grid-col:${image.column === "left" ? 1 : 3}; --grid-row:${image.row};`}
					>
						<figure>
							<img
								class="magnetic-target pressable"
								src={image.src}
								alt={image.alt}
								loading="lazy"
								decoding="async"
								data-magnetic
							/>
						</figure>
					</li>
				))
			}
		</ul>
	</article>

	<div class="project-image-controls" data-project-image-controls aria-label="Controlli dimensione immagini">
		<button class="project-image-control is-decrease pressable pressable-control" type="button" data-project-image-decrease aria-label="Rimpicciolisci immagini" disabled>-</button>
		<button class="project-image-control is-increase pressable pressable-control" type="button" data-project-image-increase aria-label="Ingrandisci immagini">+</button>
	</div>
</SectionsLayout>

<style>
	.project-page {
		max-width: 100%;
	}

	.project-image-controls {
		position: fixed;
		right: calc(var(--edge) + var(--space-48));
		bottom: var(--edge);
		z-index: 24;
		display: flex;
		align-items: center;
		gap: var(--space-8);
		color: #fff;
		mix-blend-mode: difference;
		line-height: 1;
		transform: translateY(-0.18rem);
		transition: opacity 260ms ease;
	}

	.project-image-controls.is-hidden {
		opacity: 0;
		pointer-events: none;
	}

	.project-image-control {
		appearance: none;
		border: 0;
		padding: 0;
		background: transparent;
		color: inherit;
		font: inherit;
		line-height: 1;
		cursor: pointer;
		width: 0.9em;
		height: 1em;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		transform-origin: 50% 50%;
		transition:
			opacity 240ms ease,
			transform 170ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.project-image-control.is-decrease {
		opacity: 0;
		pointer-events: none;
		transform: translateY(0.08em) rotate(90deg) scale(0.72);
	}

	.project-image-controls.has-decrease .project-image-control.is-decrease {
		opacity: 1;
		pointer-events: auto;
		transform: translateY(0) rotate(0deg) scale(var(--press-scale));
	}

	.project-image-control.is-increase {
		transform: scale(var(--press-scale));
	}

	.project-image-control.is-increase[hidden] {
		display: none;
	}

	.hero {
		margin: 0;
		display: grid;
		gap: var(--space-16);
	}

	.hero-head {
		display: grid;
		--hero-col: 17rem;
		grid-template-columns: var(--hero-col) minmax(16rem, 32rem);
		align-items: start;
		column-gap: var(--space-64);
	}

	.project-page.is-image-scale-1 .hero-head {
		--hero-col: 19rem;
	}

	.project-page.is-image-scale-2 .hero-head {
		--hero-col: 21rem;
	}

	.project-page.is-image-scale-3 .hero-head {
		--hero-col: 23rem;
	}

	.project-page.is-image-scale-4 .hero-head {
		--hero-col: 25rem;
	}

	.project-page.is-image-scale-5 .hero-head {
		--hero-col: 27rem;
	}

	.hero img {
		width: 17rem;
		height: auto;
		display: block;
	}

	.project-page.is-image-scale-1 .hero img {
		width: 19rem;
	}

	.project-page.is-image-scale-2 .hero img {
		width: 21rem;
	}

	.project-page.is-image-scale-3 .hero img {
		width: 23rem;
	}

	.project-page.is-image-scale-4 .hero img {
		width: 25rem;
	}

	.project-page.is-image-scale-5 .hero img {
		width: 27rem;
	}

	.hero figcaption {
		display: flex;
		align-items: baseline;
		gap: var(--space-8);
	}

	.status-tag {
		font-style: italic;
	}

	.teaser {
		max-width: 26rem;
		margin: var(--space-12) 0 0;
		white-space: pre-line;
	}

	.teaser-inline {
		margin: 0;
		max-width: clamp(16rem, 30vw, 32rem);
	}

	.project-grid {
		list-style: none;
		padding: 0;
		margin: var(--space-64) 0 0;
		display: grid;
		--project-col: clamp(14rem, 22vw, 21rem);
		--project-gap-col: clamp(14rem, 22vw, 21rem);
		grid-template-columns: var(--project-col) var(--project-gap-col) var(--project-col);
		justify-content: start;
		column-gap: var(--space-48);
		row-gap: var(--space-96);
	}

	.grid-item {
		margin: 0;
		grid-column: var(--grid-col, 1);
		grid-row: var(--grid-row, auto);
		justify-self: start;
		width: 100%;
	}

	.grid-item figure {
		margin: 0;
	}

	.grid-item img {
		width: 100%;
		height: auto;
		display: block;
	}

	.grid-item.is-right {
		justify-self: end;
	}

	.grid-item.is-emphasized {
		width: min(calc(100% + var(--space-96)), clamp(21rem, 34vw, 30rem));
	}

	.project-page.is-image-scale-1 .project-grid {
		--project-col: clamp(15.75rem, 24.75vw, 23.5rem);
		--project-gap-col: clamp(12.25rem, 19.25vw, 18.5rem);
	}

	.project-page.is-image-scale-2 .project-grid {
		--project-col: clamp(17.5rem, 27.5vw, 26rem);
		--project-gap-col: clamp(10.5rem, 16.5vw, 16rem);
	}

	.project-page.is-image-scale-3 .project-grid {
		--project-col: clamp(19.25rem, 30.25vw, 28.5rem);
		--project-gap-col: clamp(8.75rem, 13.75vw, 13.5rem);
	}

	.project-page.is-image-scale-4 .project-grid {
		--project-col: clamp(21rem, 33vw, 31rem);
		--project-gap-col: clamp(7rem, 11vw, 11rem);
	}

	.project-page.is-image-scale-5 .project-grid {
		--project-col: clamp(22.75rem, 35.75vw, 33.5rem);
		--project-gap-col: clamp(5.25rem, 8.25vw, 8.5rem);
	}

	@media (max-width: 980px) {
		.project-image-controls {
			display: none;
		}

		.hero-head {
			grid-template-columns: 1fr;
			row-gap: var(--space-16);
		}

		.hero img {
			width: 22rem;
		}

		.project-page.is-image-scale-1 .hero img {
			width: min(100%, 24rem);
		}

		.project-page.is-image-scale-2 .hero img {
			width: min(100%, 26rem);
		}

		.project-page.is-image-scale-3 .hero img {
			width: min(100%, 28rem);
		}

		.project-page.is-image-scale-4 .hero img {
			width: min(100%, 30rem);
		}

		.project-page.is-image-scale-5 .hero img {
			width: min(100%, 32rem);
		}

		.project-grid {
			grid-template-columns: 1fr;
			row-gap: var(--space-64);
		}

		.grid-item {
			grid-column: 1;
			grid-row: auto;
			justify-self: start;
			width: min(100%, clamp(16rem, 72vw, 24rem));
		}

		.grid-item.is-emphasized {
			width: min(100%, clamp(18rem, 82vw, 28rem));
		}

		.project-page.is-image-scale-1 .grid-item {
			width: min(100%, clamp(17.5rem, 79vw, 26rem));
		}

		.project-page.is-image-scale-1 .grid-item.is-emphasized {
			width: min(100%, clamp(19rem, 88vw, 30rem));
		}

		.project-page.is-image-scale-2 .grid-item {
			width: min(100%, clamp(19rem, 86vw, 28rem));
		}

		.project-page.is-image-scale-2 .grid-item.is-emphasized {
			width: min(100%, clamp(20rem, 92vw, 32rem));
		}

		.project-page.is-image-scale-3 .grid-item {
			width: min(100%, clamp(20.5rem, 90vw, 30rem));
		}

		.project-page.is-image-scale-3 .grid-item.is-emphasized {
			width: min(100%, clamp(21rem, 94vw, 34rem));
		}

		.project-page.is-image-scale-4 .grid-item {
			width: min(100%, clamp(22rem, 94vw, 32rem));
		}

		.project-page.is-image-scale-4 .grid-item.is-emphasized {
			width: min(100%, clamp(22.5rem, 96vw, 36rem));
		}

		.project-page.is-image-scale-5 .grid-item {
			width: min(100%, clamp(23.5rem, 96vw, 34rem));
		}

		.project-page.is-image-scale-5 .grid-item.is-emphasized {
			width: min(100%, clamp(24rem, 98vw, 38rem));
		}
	}
</style>

<script>
	const projectPage = document.querySelector(".project-page");
	const controls = document.querySelector("[data-project-image-controls]");
	const decrease = document.querySelector("[data-project-image-decrease]");
	const increase = document.querySelector("[data-project-image-increase]");
	const canResizeImages = window.matchMedia("(min-width: 981px)").matches;

	if (canResizeImages && projectPage instanceof HTMLElement && controls instanceof HTMLElement && decrease instanceof HTMLButtonElement && increase instanceof HTMLButtonElement) {
		let level = 0;
		const maxLevel = 5;
		let revealTimer;

		const applyLevel = () => {
			for (let index = 1; index <= maxLevel; index += 1) {
				projectPage.classList.toggle(`is-image-scale-${index}`, level === index);
			}
			controls.classList.toggle("has-decrease", level > 0);
			decrease.disabled = level === 0;
		};

		const hide = () => controls.classList.add("is-hidden");
		const showLater = () => {
			clearTimeout(revealTimer);
			revealTimer = window.setTimeout(() => {
				controls.classList.remove("is-hidden");
			}, 700);
		};
		const onScrollIntent = () => {
			hide();
			showLater();
		};

		decrease.addEventListener("click", () => {
			level = Math.max(0, level - 1);
			applyLevel();
		});

		increase.addEventListener("click", () => {
			level = Math.min(maxLevel, level + 1);
			applyLevel();
		});

		window.addEventListener("wheel", onScrollIntent, { passive: true });
		document.addEventListener("scroll", onScrollIntent, { passive: true, capture: true });

		applyLevel();
	}
</script>
