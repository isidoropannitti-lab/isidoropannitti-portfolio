---
import SectionsLayout from "../layouts/SectionsLayout.astro";

const PHOTO_IMAGES = [
	"/images/photo/algarve-2025-01.jpeg",
	"/images/photo/ahmedabad-2024-01.jpeg",
	"/images/photo/ahmedabad-2024-02.jpeg",
	"/images/photo/ahmedabad-2024-03.jpeg",
	"/images/photo/ahmedabad-2024-04.jpeg",
	"/images/photo/andalusia-2025-01.jpeg",
	"/images/photo/andalusia-2025-02.jpeg",
	"/images/photo/new-york-2025-01.jpeg",
	"/images/photo/barcellona-2025-03.jpeg",
];

const SIZE_VARIANTS = [
	"is-base",
	"is-compact",
	"is-base",
	"is-wide",
	"is-compact",
	"is-base",
	"is-wide",
	"is-base",
	"is-base",
];

const LOCATION_LABELS: Record<string, string> = {
	algarve: "Algarve",
	ahmedabad: "Ahmedabad",
	andalusia: "Andalusia",
	"new-york": "New York",
	barcellona: "Barcellona",
};

const photos = PHOTO_IMAGES.map((src, index) => {
	const filename = decodeURIComponent(src.split("/").pop() ?? "");
	const slug = filename.replace(/\.(jpe?g|png|webp|heic)$/i, "");
	const match = slug.match(/^(.*)-(\d{4})-(\d{2})$/i);
	const locationKey = match?.[1] ?? slug;
	const year = match?.[2]?.slice(-2) ?? "";
	const sequence = match?.[3] ?? "";

	return {
		src,
		code: year && sequence ? `${year}.${sequence}` : slug,
		location: LOCATION_LABELS[locationKey] ?? locationKey,
		variant: SIZE_VARIANTS[index] ?? "is-base",
	};
});
---

<SectionsLayout title="foto | isidoro pannitti architetto" section="photo" lang="it" lockMobileScrollY>
	<div class="gallery" aria-label="Photo sequence">
		{
			photos.map((photo, index) => (
				<figure class:list={["preview", photo.variant]}>
					<input class="location-toggle" type="checkbox" id={`photo-toggle-it-${index}`} />
					<label class="photo-trigger" for={`photo-toggle-it-${index}`}>
						<img src={encodeURI(photo.src)} alt={photo.location} loading="eager" />
					</label>
					<figcaption>
						<span>{photo.code}</span>
						<span class="location-label" aria-live="polite">{photo.location}</span>
					</figcaption>
				</figure>
			))
		}
	</div>
</SectionsLayout>

<style>
	.gallery {
		display: flex;
		align-items: flex-start;
		flex-wrap: nowrap;
		box-sizing: border-box;
		width: calc(100% + (var(--edge) * 2));
		gap: clamp(0.75rem, 1.8vw, 1.2rem);
		margin-inline: calc(var(--edge) * -1);
		overflow-x: auto;
		overscroll-behavior-x: contain;
		padding-left: var(--edge);
		padding-right: 0;
		scroll-padding-left: var(--edge);
		scroll-snap-type: x mandatory;
		touch-action: pan-x;
		-webkit-overflow-scrolling: touch;
		padding-bottom: 0.45rem;
		scrollbar-width: none;
		-ms-overflow-style: none;
	}

	.gallery::-webkit-scrollbar {
		width: 0;
		height: 0;
		display: none;
	}

	.preview {
		flex: 0 0 auto;
		margin: 0;
		display: grid;
		gap: 0.45rem;
		scroll-snap-align: start;
	}

	.location-toggle {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}

	.photo-trigger {
		display: block;
		cursor: pointer;
	}

	.preview img {
		display: block;
		width: 17rem;
		height: auto;
	}

	.preview.is-compact img {
		width: 15.4rem;
	}

	.preview.is-wide img {
		width: 18rem;
	}

	.preview figcaption {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		max-width: 100%;
		overflow-wrap: anywhere;
	}

	.location-label {
		opacity: 0;
		transform: translateY(0.08rem);
		transition: opacity 220ms ease, transform 220ms ease;
	}

	.location-toggle:checked ~ figcaption .location-label {
		opacity: 1;
		transform: translateY(0);
	}

	@media (max-width: 760px) {
		.preview img {
			width: 22rem;
		}

		.preview.is-compact img {
			width: 20rem;
		}

		.preview.is-wide img {
			width: 23.4rem;
		}
	}
</style>
